# Plantilla de variables de entorno. Copiar a .env.local (desarrollo) o cargar en el panel de Vercel (producción).
# NUNCA poner valores reales en este archivo: se versiona.

# Conexión a Postgres de Supabase. En Vercel conviene el pooler en modo transacción (puerto 6543).
DATABASE_URL=

# Proyecto de Supabase (la clave "publishable" es pública por diseño; la seguridad la dan RLS y la autorización del servidor).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Dominio público con https:// (sin barra final). Obligatoria en producción: define el destino del enlace de acceso.
SITE_URL=

# Opcionales
# DATABASE_POOL_MAX=5
# SUPABASE_SERVICE_ROLE_KEY=   # solo servidor: permite borrar la identidad de Auth al eliminar la cuenta

# Correo para que los titulares pidan el retiro de una imagen (se muestra en /creditos). Opcional: sin valor, esa línea no aparece.
NEXT_PUBLIC_CONTACT_EMAIL=
