generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String           @id @default(cuid())
  supabaseId  String?          @unique
  email       String           @unique
  name        String?
  collections UserCollection[]
  profile     UserProfile?
  wearLogs    WearLog[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Perfume {
  id            String  @id @default(cuid())
  brand         String
  name          String
  gender        String
  concentration String?
  releaseYear   Int?
  perfumer      String?
  description   String?
  imageUrl      String?

  duration   Int?
  projection Int?
  seasons    String[]
  occasions  String[]

  notes       PerfumeNote[]
  accords     PerfumeAccord[]
  collectedBy UserCollection[]
  wearLogs    WearLog[]
  remindsOf   PerfumeSimilar[] @relation("SimilarFrom")
  remindedBy  PerfumeSimilar[] @relation("SimilarTo")
  priceTier   PriceTier?

  // Publicación y procedencia (RF-06): el catálogo público solo muestra PUBLISHED.
  status      PublicationStatus @default(PUBLISHED)
  source      String?
  imageSource String?
  /// Página de origen de la imagen (para el crédito). La imagen se enlaza (hotlink), no se copia.
  imageSourceUrl String?

  // Valoración de la fuente de datos; se usa solo como señal de popularidad, nunca se muestra como rating público.
  ratingValue Float?
  ratingCount Int?

  // Datos de la comunidad de la fuente (dataset de Kaggle, CC BY-NC-SA 4.0): id en Fragrantica para enlazar re-importaciones,
  // duración (1-5) y estela (1-4) promedio, y el resto de las votaciones como JSON (solo para mostrar).
  sourceId  String? @unique
  longevity Float?
  sillage   Float?
  stats     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([brand, name], name: "brand_name")
  @@index([gender])
  @@index([concentration])
  @@index([status])
}

model Note {
  id       String        @id @default(cuid())
  name     String        @unique
  category String
  perfumes PerfumeNote[]
}

model Accord {
  id       String          @id @default(cuid())
  name     String          @unique
  perfumes PerfumeAccord[]
}

model PerfumeNote {
  perfumeId String
  noteId    String
  noteType  String
  /// Peso de la nota votado por la comunidad (0-100); null en los datos anteriores.
  weight    Int?

  perfume Perfume @relation(fields: [perfumeId], references: [id], onDelete: Cascade)
  note    Note    @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@id([perfumeId, noteId, noteType])
  @@index([noteId])
}

model PerfumeAccord {
  perfumeId String
  accordId  String
  intensity Int

  perfume Perfume @relation(fields: [perfumeId], references: [id], onDelete: Cascade)
  accord  Accord  @relation(fields: [accordId], references: [id], onDelete: Cascade)

  @@id([perfumeId, accordId])
  @@index([accordId])
}

enum CollectionStatus {
  OWNED
  SAMPLED
  WISHLIST
  DISLIKED
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
}

enum PriceTier {
  ARABIC
  DESIGNER
  NICHE
}

model UserCollection {
  userId        String
  perfumeId     String
  status        CollectionStatus
  rating        Int?
  personalNotes String?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  perfume Perfume @relation(fields: [perfumeId], references: [id], onDelete: Cascade)

  @@id([userId, perfumeId])
  @@index([status])
}

// Perfil de la persona: respuestas del quiz (no el vector, para poder recalcular si cambia
// QUIZ_VERSION) y preferencias de idioma, país y moneda (RF-08). Se elimina con la cuenta.
model UserProfile {
  userId      String   @id
  quizAnswers Json?
  quizVersion Int?
  locale      String   @default("es")
  country     String?
  currency    String?
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Registro diario de uso (racha): un perfume por persona y por día (`day` = "YYYY-MM-DD" en la zona horaria de la
// aplicación). Se elimina con la cuenta o con el perfume.
model WearLog {
  userId    String
  day       String
  perfumeId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  perfume Perfume @relation(fields: [perfumeId], references: [id], onDelete: Cascade)

  @@id([userId, day])
  @@index([perfumeId])
}

// "Me recuerda a": perfumes que la comunidad de la fuente dice que huelen parecido (votos a favor y en contra).
// Dataset de Kaggle (CC BY-NC-SA 4.0). `net` = upVotes - downVotes, para ordenar.
model PerfumeSimilar {
  perfumeId String
  similarId String
  upVotes   Int
  downVotes Int
  net       Int

  perfume Perfume @relation("SimilarFrom", fields: [perfumeId], references: [id], onDelete: Cascade)
  similar Perfume @relation("SimilarTo", fields: [similarId], references: [id], onDelete: Cascade)

  @@id([perfumeId, similarId])
  @@index([perfumeId, net])
  @@index([similarId])
}
