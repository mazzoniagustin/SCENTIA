generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String           @id @default(cuid())
  supabaseId  String?          @unique
  email       String           @unique
  name        String?
  collections UserCollection[]
  profile     UserProfile?
  wearLogs    WearLog[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Perfume {
  id            String  @id @default(cuid())
  brand         String
  name          String
  gender        String
  concentration String?
  releaseYear   Int?
  perfumer      String?
  description   String?
  imageUrl      String?

  duration   Int?
  projection Int?
  seasons    String[]
  occasions  String[]

  notes       PerfumeNote[]
  accords     PerfumeAccord[]
  collectedBy UserCollection[]
  wearLogs    WearLog[]
  priceTier   PriceTier?

  // Publicación y procedencia (RF-06): el catálogo público solo muestra PUBLISHED.
  status      PublicationStatus @default(PUBLISHED)
  source      String?
  imageSource String?

  // Valoración de la fuente de datos; se usa solo como señal de popularidad, nunca se muestra como rating público.
  ratingValue Float?
  ratingCount Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([brand, name], name: "brand_name")
  @@index([gender])
  @@index([concentration])
  @@index([status])
}

model Note {
  id       String        @id @default(cuid())
  name     String        @unique
  category String
  perfumes PerfumeNote[]
}

model Accord {
  id       String          @id @default(cuid())
  name     String          @unique
  perfumes PerfumeAccord[]
}

model PerfumeNote {
  perfumeId String
  noteId    String
  noteType  String

  perfume Perfume @relation(fields: [perfumeId], references: [id], onDelete: Cascade)
  note    Note    @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@id([perfumeId, noteId, noteType])
  @@index([noteId])
}

model PerfumeAccord {
  perfumeId String
  accordId  String
  intensity Int

  perfume Perfume @relation(fields: [perfumeId], references: [id], onDelete: Cascade)
  accord  Accord  @relation(fields: [accordId], references: [id], onDelete: Cascade)

  @@id([perfumeId, accordId])
  @@index([accordId])
}

enum CollectionStatus {
  OWNED
  SAMPLED
  WISHLIST
  DISLIKED
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
}

enum PriceTier {
  ARABIC
  DESIGNER
  NICHE
}

model UserCollection {
  userId        String
  perfumeId     String
  status        CollectionStatus
  rating        Int?
  personalNotes String?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  perfume Perfume @relation(fields: [perfumeId], references: [id], onDelete: Cascade)

  @@id([userId, perfumeId])
  @@index([status])
}

// Perfil de la persona: respuestas del quiz (no el vector, para poder recalcular si cambia
// QUIZ_VERSION) y preferencias de idioma, país y moneda (RF-08). Se elimina con la cuenta.
model UserProfile {
  userId      String   @id
  quizAnswers Json?
  quizVersion Int?
  locale      String   @default("es")
  country     String?
  currency    String?
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Registro diario de uso (racha): un perfume por persona y por día (`day` = "YYYY-MM-DD" en la zona horaria de la
// aplicación). Se elimina con la cuenta o con el perfume.
model WearLog {
  userId    String
  day       String
  perfumeId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  perfume Perfume @relation(fields: [perfumeId], references: [id], onDelete: Cascade)

  @@id([userId, day])
  @@index([perfumeId])
}
